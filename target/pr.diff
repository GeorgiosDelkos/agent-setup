diff --git a/claude/hooks/memory/recall-gate.sh b/claude/hooks/memory/recall-gate.sh
new file mode 100755
index 0000000..39caab2
--- /dev/null
+++ b/claude/hooks/memory/recall-gate.sh
@@ -0,0 +1,92 @@
+#!/usr/bin/env bash
+# PreToolUse (file edits): hippius-mem is the team's shared memory, and AGENTS.md (Team
+# memory) makes recalling it before acting mandatory. This gate makes that checkable: an edit
+# to a file inside a git work tree is denied until this session has called the hippius-mem
+# `recall` tool within RECALL_WINDOW_SECS. recall-seen.sh records the call.
+#
+# It fails open, with a message, whenever recalling is impossible, because a gate that cannot
+# be satisfied stops all work. A team note records a server-down deadlock with upstream's
+# gate that cost about twelve hours of agent time. So the edit goes ahead when hippius-mem is
+# not registered for Claude or Grok, or when the registered HTTP daemon does not answer
+# within a second. A registered stdio server cannot be probed without starting it, so it
+# counts as up.
+#
+# Not gated: paths outside any git work tree, the Claude scratchpad (common.sh
+# scratch_exempt), and sessions with HIPPIUS_MEM_HOOKS_BYPASS=1 (upstream's name, so one
+# switch turns off both this gate and the gate `hippius-mem init` installs in a repo).
+#
+# The recall is session-wide: a Claude subagent shares its parent's session id and rides the
+# parent's recall, while a Grok subagent has its own session and recalls for itself. Subagent
+# prompts carry the recall directive (AGENTS.md) either way.
+set -euo pipefail
+
+# shellcheck source-path=SCRIPTDIR source=../rust/common.sh
+source "$(dirname "${BASH_SOURCE[0]}")/../rust/common.sh"
+
+# Upstream's default refresh window (HIPPIUS_MEM_RECALL_WINDOW_SECS, 1800 s), so a session
+# recalls again on a long task the same way in a provisioned repo and anywhere else.
+RECALL_WINDOW_SECS="${HIPPIUS_MEM_RECALL_WINDOW_SECS:-1800}"
+
+read_hook_input
+need_tools fail-open jq
+
+if [[ "${HIPPIUS_MEM_HOOKS_BYPASS:-0}" == 1 ]]; then
+  exit 0
+fi
+
+path="$(tool_path)"
+if [[ -z "$path" ]] || scratch_exempt "$path"; then
+  exit 0
+fi
+dir="$path"
+while [[ ! -d "$dir" ]]; do
+  dir="$(dirname "$dir")"
+done
+if ! git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
+  exit 0
+fi
+
+recall_file="$(session_file memory-recall)"
+if [[ -s "$recall_file" ]]; then
+  age=$(($(date +%s) - $(cat "$recall_file")))
+  if ((age < RECALL_WINDOW_SECS)); then
+    touch "$(session_file memory-edited)"
+    exit 0
+  fi
+fi
+
+# The Claude registration: an HTTP url, or a stdio command. Empty when not registered.
+claude_entry=""
+if [[ -f "$HOME/.claude.json" ]]; then
+  claude_entry="$(jq -r '.mcpServers["hippius-mem"] | .url // .command // empty' \
+    "$HOME/.claude.json" 2>/dev/null || true)"
+fi
+grok_registered=no
+if grep -qF '[mcp_servers.hippius-mem]' "$HOME/.grok/config.toml" 2>/dev/null; then
+  grok_registered=yes
+fi
+
+fail_open() {
+  echo "hippius-mem recall gate: $1, so this edit is not gated. Team memory is still" \
+    "mandatory: recall before acting once it is back (AGENTS.md, Team memory)." >&2
+  touch "$(session_file memory-edited)"
+  exit 1
+}
+if [[ -z "$claude_entry" && "$grok_registered" == no ]]; then
+  fail_open "hippius-mem is not registered for Claude or Grok (run install.sh)"
+fi
+if [[ "$claude_entry" == http* ]] && ! curl -s -o /dev/null -m 1 "$claude_entry"; then
+  fail_open "the hippius-mem daemon at $claude_entry does not answer"
+fi
+
+reason="BLOCKED: recall team memory before editing $path. Call the hippius-mem recall tool"
+reason+=" (mcp__hippius-mem__recall) with a query naming what you are about to change, read"
+reason+=" the summaries, get the relevant notes, then retry the edit. One recall opens edits"
+reason+=" for $((RECALL_WINDOW_SECS / 60)) minutes. If recall itself fails, report it; the"
+reason+=" owner can set HIPPIUS_MEM_HOOKS_BYPASS=1."
+if [[ -s "$recall_file" ]]; then
+  reason+=" (Last recall was $((age / 60)) minutes ago.)"
+fi
+jq -n --arg reason "$reason" '{hookSpecificOutput: {hookEventName: "PreToolUse",
+  permissionDecision: "deny", permissionDecisionReason: $reason}}'
+echo "BLOCKED: recall hippius-mem before editing $path" >&2
diff --git a/claude/hooks/memory/recall-seen.sh b/claude/hooks/memory/recall-seen.sh
new file mode 100755
index 0000000..103567a
--- /dev/null
+++ b/claude/hooks/memory/recall-seen.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+# PostToolUse (hippius-mem recall and remember): records the call for this session.
+# recall-gate.sh reads the recall time; remember-checkpoint.sh skips its question when the
+# session already called remember. Claude names the tools mcp__hippius-mem__<tool>, Grok
+# hippius-mem__<tool>. PostToolUse fires only after a call that succeeded.
+set -euo pipefail
+
+# shellcheck source-path=SCRIPTDIR source=../rust/common.sh
+source "$(dirname "${BASH_SOURCE[0]}")/../rust/common.sh"
+read_hook_input
+need_tools fail-open jq
+
+case "$(hook_field '.tool_name // .toolName')" in
+*hippius-mem__recall)
+  date +%s >"$(session_file memory-recall)"
+  ;;
+*hippius-mem__remember)
+  touch "$(session_file memory-remembered)"
+  ;;
+esac
diff --git a/claude/hooks/memory/remember-checkpoint.sh b/claude/hooks/memory/remember-checkpoint.sh
new file mode 100755
index 0000000..1ab28e2
--- /dev/null
+++ b/claude/hooks/memory/remember-checkpoint.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# Stop: the "remember after" half of the team-memory mandate (AGENTS.md, Team memory). Once
+# per session, and only when the session edited files in a git repo (recall-gate.sh records
+# that) and has not called remember, the stop is blocked with one question: is there a
+# durable decision, gotcha, convention or reference to record? A hook cannot judge that, so
+# it forces the decision, not a write. Sessions that only answered questions are not asked.
+#
+# Loop safety: the marker is written before the block, so the agent is asked at most once,
+# and a stop that is already a hook-driven continuation passes (common.sh stop_is_exempt).
+set -euo pipefail
+
+# shellcheck source-path=SCRIPTDIR source=../rust/common.sh
+source "$(dirname "${BASH_SOURCE[0]}")/../rust/common.sh"
+read_hook_input
+need_tools fail-open jq
+
+if [[ "${HIPPIUS_MEM_HOOKS_BYPASS:-0}" == 1 ]] || stop_is_exempt || is_subagent; then
+  exit 0
+fi
+asked="$(session_file memory-asked)"
+if [[ ! -f "$(session_file memory-edited)" || -f "$(session_file memory-remembered)" ||
+-f "$asked" ]]; then
+  exit 0
+fi
+touch "$asked"
+
+cat >&2 <<'EOF'
+hippius-mem remember checkpoint: did this session produce a durable, team-relevant learning
+(a decision, gotcha, convention or reference) that a teammate's agent would need and that the
+code and git history do not already show? If yes, call the hippius-mem remember tool now: one
+self-contained fact per note, with a keyword-rich summary. If not, say "no durable learning to
+record" and stop. Asked once per session.
+EOF
+exit 2
diff --git a/claude/hooks/memory/tests/run.sh b/claude/hooks/memory/tests/run.sh
new file mode 100755
index 0000000..7b359c6
--- /dev/null
+++ b/claude/hooks/memory/tests/run.sh
@@ -0,0 +1,165 @@
+#!/usr/bin/env bash
+# Tests for the team-memory hooks in the directory above this one. Each hook is fed Claude
+# and Grok JSON inputs with HOME and TMPDIR pointed at scratch directories, so the real
+# ~/.claude.json, ~/.grok and hook state are never read. A stdio registration stands for a
+# live server (the gate cannot probe one); an HTTP url on a closed port stands for a daemon
+# that is down.
+set -euo pipefail
+
+HOOKS="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+WORK="$(cd "$(mktemp -d "${TMPDIR:-/tmp}/memory-hooks-test.XXXXXX")" && pwd -P)"
+trap 'trash "$WORK"' EXIT
+pass=0
+fail=0
+
+REPO="$WORK/repo"
+git init -q "$REPO"
+OUTSIDE="$WORK/plain/notes.txt"
+mkdir -p "$WORK/plain"
+FAKE_HOME="$WORK/home"
+STATE_TMP="$WORK/tmp"
+mkdir -p "$FAKE_HOME/.grok" "$STATE_TMP"
+
+check() {
+  local name="$1" ok="$2" detail="${3:-}"
+  if [[ "$ok" == yes ]]; then
+    pass=$((pass + 1))
+    return
+  fi
+  fail=$((fail + 1))
+  printf 'FAIL: %s\n' "$name"
+  if [[ -n "$detail" ]]; then
+    printf '%s\n' "$detail" | sed 's/^/    /'
+  fi
+}
+
+# Registration in the fake home: none, stdio (counts as up), down (HTTP on a closed port),
+# or grok (only Grok's config names the server).
+register() {
+  trash "$FAKE_HOME/.claude.json" "$FAKE_HOME/.grok/config.toml" 2>/dev/null || true
+  case "$1" in
+  stdio) echo '{"mcpServers": {"hippius-mem": {"command": "hippius-mem"}}}' ;;
+  down) echo '{"mcpServers": {"hippius-mem": {"url": "http://127.0.0.1:1/mcp"}}}' ;;
+  *) echo '{}' ;;
+  esac >"$FAKE_HOME/.claude.json"
+  if [[ "$1" == grok ]]; then
+    printf '[mcp_servers.hippius-mem]\nurl = "http://127.0.0.1:1/mcp"\n' \
+      >"$FAKE_HOME/.grok/config.toml"
+  fi
+}
+
+# Runs hook $1 with JSON $2, extra environment in $3... Sets $code and $out (stderr, plus
+# the deny reason of a JSON deny on stdout, which counts as exit 2).
+run_hook() {
+  local hook="$1" input="$2" stdout
+  shift 2
+  code=0
+  stdout="$(env HOME="$FAKE_HOME" TMPDIR="$STATE_TMP" "$@" bash "$HOOKS/$hook" \
+    <<<"$input" 2>"$WORK/stderr")" || code=$?
+  out="$(cat "$WORK/stderr")"
+  if [[ "$stdout" == *'"permissionDecision"'* ]]; then
+    code=2
+    out="$(jq -r '.hookSpecificOutput.permissionDecisionReason' <<<"$stdout")"$'\n'"$out"
+  fi
+}
+
+# expect NAME CODE HOOK JSON NEEDLE [ENV...]: exit code is CODE and output contains NEEDLE.
+expect() {
+  local name="$1" want="$2" hook="$3" input="$4" needle="${5:-}"
+  shift 5
+  run_hook "$hook" "$input" "$@"
+  local ok=no
+  if [[ "$code" -eq "$want" && "$out" == *"$needle"* ]]; then
+    ok=yes
+  fi
+  check "$name" "$ok" "exit $code, want $want; output: $out"
+}
+
+edit() {
+  jq -nc --arg s "$1" --arg p "$2" \
+    '{session_id: $s, tool_name: "Edit", tool_input: {file_path: $p}}'
+}
+grok_edit() {
+  jq -nc --arg s "$1" --arg p "$2" \
+    '{session_id: $s, tool_name: "search_replace", tool_input: {target_file: $p}}'
+}
+tool_call() {
+  jq -nc --arg s "$1" --arg t "$2" '{session_id: $s, tool_name: $t, tool_input: {}}'
+}
+stop() {
+  local extra="${2:-}"
+  if [[ -z "$extra" ]]; then
+    extra="{}"
+  fi
+  jq -nc --arg s "$1" --argjson extra "$extra" \
+    '{session_id: $s, hook_event_name: "Stop"} + $extra'
+}
+
+# ---- recall-gate.sh ---------------------------------------------------------------------
+
+register stdio
+file="$REPO/src/new.rs"
+expect "gate: edit in a git repo before recall is denied" 2 recall-gate.sh \
+  "$(edit s1 "$file")" "recall team memory"
+expect "gate: Grok edit before recall is denied" 2 recall-gate.sh \
+  "$(grok_edit s1 "$file")" "mcp__hippius-mem__recall"
+expect "gate: edit outside any git repo passes" 0 recall-gate.sh "$(edit s1 "$OUTSIDE")" ""
+expect "gate: bypass passes" 0 recall-gate.sh "$(edit s1 "$file")" "" HIPPIUS_MEM_HOOKS_BYPASS=1
+
+expect "seen: Claude recall is recorded" 0 recall-seen.sh \
+  "$(tool_call s1 mcp__hippius-mem__recall)" ""
+expect "gate: edit after recall passes" 0 recall-gate.sh "$(edit s1 "$file")" ""
+expect "gate: another session still has to recall" 2 recall-gate.sh "$(edit s2 "$file")" ""
+
+expect "seen: Grok recall is recorded" 0 recall-seen.sh "$(tool_call s3 hippius-mem__recall)" ""
+expect "gate: Grok edit after Grok recall passes" 0 recall-gate.sh "$(grok_edit s3 "$file")" ""
+expect "seen: another tool records nothing" 0 recall-seen.sh \
+  "$(tool_call s4 mcp__hippius-mem__get)" ""
+expect "gate: get is not a recall" 2 recall-gate.sh "$(edit s4 "$file")" ""
+
+echo $(($(date +%s) - 3600)) >"$STATE_TMP/claude-rust-hooks/s5.memory-recall"
+expect "gate: recall older than the window is denied" 2 recall-gate.sh \
+  "$(edit s5 "$file")" "60 minutes ago"
+expect "gate: a longer window accepts it" 0 recall-gate.sh "$(edit s5 "$file")" "" \
+  HIPPIUS_MEM_RECALL_WINDOW_SECS=7200
+
+register grok
+expect "gate: registered for Grok only is still enforced" 2 recall-gate.sh \
+  "$(edit s6 "$file")" "recall team memory"
+register none
+expect "gate: not registered fails open with a message" 1 recall-gate.sh \
+  "$(edit s6 "$file")" "not registered"
+register down
+expect "gate: daemon down fails open with a message" 1 recall-gate.sh \
+  "$(edit s6 "$file")" "does not answer"
+register stdio
+
+# ---- remember-checkpoint.sh -------------------------------------------------------------
+
+expect "checkpoint: session without edits stops" 0 remember-checkpoint.sh "$(stop s7)" ""
+expect "checkpoint: denied edit does not count as an edit" 0 remember-checkpoint.sh \
+  "$(stop s2)" ""
+
+run_hook recall-seen.sh "$(tool_call s8 mcp__hippius-mem__recall)"
+run_hook recall-gate.sh "$(edit s8 "$file")"
+expect "checkpoint: session that edited is asked" 2 remember-checkpoint.sh "$(stop s8)" \
+  "remember checkpoint"
+expect "checkpoint: asked only once" 0 remember-checkpoint.sh "$(stop s8)" ""
+
+run_hook recall-seen.sh "$(tool_call s9 mcp__hippius-mem__recall)"
+run_hook recall-gate.sh "$(edit s9 "$file")"
+expect "checkpoint: hook-driven continuation passes" 0 remember-checkpoint.sh \
+  "$(stop s9 '{"stop_hook_active": true}')" ""
+expect "checkpoint: Grok shutdown stop passes" 0 remember-checkpoint.sh \
+  "$(stop s9 '{"reason": "shutdown"}')" ""
+expect "seen: remember is recorded" 0 recall-seen.sh "$(tool_call s9 hippius-mem__remember)" ""
+expect "checkpoint: session that remembered is not asked" 0 remember-checkpoint.sh \
+  "$(stop s9)" ""
+
+register none
+run_hook recall-gate.sh "$(edit s10 "$file")"
+expect "checkpoint: fail-open edit still counts" 2 remember-checkpoint.sh "$(stop s10)" \
+  "remember checkpoint"
+
+printf '%d passed, %d failed\n' "$pass" "$fail"
+((fail == 0))
